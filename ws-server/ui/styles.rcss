.window {
	height: 100%;
	display: flex;
	flex-direction: column;
	padding: 0;
	box-sizing: border-box;
}
.window-body {
	display: flex;
	flex-direction: column;
	overflow: hidden;
	flex: 1;
	min-height: 0;
}

.status-bar {
	box-shadow: none;
	border-top-width: 2dp;
	border-top-color: #808080;
}
#status-version { flex-grow: 0; }

menu[role=tablist] { margin: 10dp 0 -2dp; }

.field-row, .window-body .field-row { margin: 10dp 0 0; }
fieldset > legend + .field-row,
fieldset > legend + .field-row-stacked { margin-top: 0; }

article[role=tabpanel] {
	flex: 1;
	overflow-y: auto;
	min-height: 0;
	margin-bottom: 0;
}

.update-bar {
	display: flex;
	align-items: center;
	gap: 8dp;
	padding: 4dp 8dp;
	background-color: #fffbe6;
	border-bottom-width: 1dp;
	border-bottom-color: #e0c000;
	font-size: 11dp;
	flex-shrink: 0;
	flex-wrap: wrap;
}
.update-bar-btns { display: flex; align-items: center; gap: 4dp; margin-left: auto; }

.modal-overlay {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background-color: #00000073;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 100;
}
.modal-overlay .window {
	height: auto;
	display: block;
	width: 260dp;
}
.modal-overlay .window.wide { width: 280dp; }

#admin-warning, #linux-perm-warning {
	flex-shrink: 0;
	margin: 0;
	white-space: pre-wrap;
	font-size: 11dp;
}
.warn-line { display: flex; align-items: baseline; }
.warn-text { flex: 1; }
.warn-icon { margin-right: 7dp; animation: 1s sine-in-out infinite warn-flash; }
@keyframes warn-flash {
	0% { color: #c00000; }
	50% { color: transparent; }
	100% { color: #c00000; }
}

.about-gif { width: 96dp; height: 96dp; }
.accent-link { color: #003c74; text-decoration: none; cursor: pointer; }
.accent-link:hover { text-decoration: underline; }

#save-msg { margin-right: auto; font-size: 11dp; color: #003c74; }
#save-msg.dirty-msg { color: #856000; }
#save-btn.dirty { font-weight: bold; }

.key-list {
	background-color: #fff;
	border-width: 1dp;
	border-color: #808080 #dfdfdf #dfdfdf #808080;
	min-height: 60dp;
	overflow-y: auto;
	padding: 6dp;
	margin-top: 4dp;
	display: flex;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: 4dp;
}
.key-empty { font-size: 11dp; color: #555; padding: 2dp 4dp; }
button.key-tag {
	font-size: 11dp;
	font-weight: bold;
	padding: 2dp 8dp;
	letter-spacing: 0.3dp;
}
button.key-tag:hover { color: #c00000; }
#add-key-btn.listening, #add-key-btn.listening:hover {
	box-shadow: #fff -1dp -1dp 0 inset, #0a0a0a 1dp 1dp 0 inset,
		#dfdfdf -2dp -2dp 0 inset, #808080 2dp 2dp 0 inset;
}

#http-host { opacity: 0.5; cursor: arrow; }
#theme-toggle { opacity: 0.5; flex-grow: 0; cursor: pointer; }
#theme-toggle.active { opacity: 1; }
#clients-count.has-clients { cursor: pointer; }

.error-lbl { color: #c00000; font-size: 11dp; display: block; margin-top: 4dp; }
#modal-discard-btn { color: #c00000; }
.muted-note { font-size: 11dp; color: #555; margin: 0 0 6dp; }
.analog-notes { margin: 6dp 0 8dp; }

.update-popup-content { padding: 8dp 12dp; gap: 8dp; }
.update-header { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.update-gif { max-width: 64dp; }
.update-popup-version { color: #003c74; font-size: 24dp; margin: 0; }
.update-notes-group { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.update-notes { flex: 1; overflow-y: auto; min-height: 0; font-size: 11dp; color: #222; word-break: break-word; }
.update-notes h1, .update-notes h2, .update-notes h3 { color: #003c74; margin: 6dp 0 3dp; }
.update-notes h1 { font-size: 13dp; }
.update-notes h2, .update-notes h3 { font-size: 12dp; }
.update-notes p { margin: 3dp 0; line-height: 1.5; }
.update-notes ul, .update-notes ol { margin: 3dp 0; padding-left: 16dp; }
.update-notes li { margin: 2dp 0; }
.update-notes li .marker { display: inline-block; width: 12dp; margin-left: -12dp; }
.update-notes code { background-color: #000; color: #c0c0c0; font-family: "Perfect DOS VGA 437 Win"; padding: 1dp 4dp; font-size: 10dp; }
.update-notes pre { padding: 4dp 8dp; margin: 3dp 0; }
.update-notes pre code { background-color: transparent; color: #222; padding: 0; }
.update-notes a { color: #003c74; }
.update-notes blockquote { border-left-width: 3dp; border-left-color: #dfdfdf; margin: 3dp 0; padding-left: 6dp; color: #555; }
.update-notes hr { border-top-width: 1dp; border-top-color: #dfdfdf; margin: 6dp 0; }
.update-notes li:first-child, .update-notes blockquote > :first-child { margin-top: 0; }
.update-notes li:last-child, .update-notes blockquote > :last-child { margin-bottom: 0; }
.update-popup-footer { display: flex; align-items: center; gap: 6dp; flex-shrink: 0; flex-wrap: wrap; }

.done-body { flex: 1; display: flex; align-items: center; position: relative; min-height: 0; }
.done-gif { position: absolute; left: 8dp; top: 50%; margin-top: -24dp; width: 48dp; height: 48dp; }
#update-done-text { margin: 0; text-align: center; width: 100%; }
.done-buttons { display: flex; justify-content: center; padding-bottom: 10dp; }

@media (theme: dark) {
	.status-bar-field { background-color: #252329; }
	.accent-link { color: #c55815; }
	#save-msg { color: #c55815; }
	.update-popup-version { color: #c55815; }
	.update-notes { color: #e8e6ea; }
	.update-notes a { color: #c55815; }
	.update-notes h1, .update-notes h2, .update-notes h3 { color: #c55815; }
	.update-notes blockquote { color: #9e9ca2; border-left-color: #3a3840; }
	.update-bar { background-color: #2a2416; border-bottom-color: #5a4200; }
	.status-bar { border-top-color: #3a3840; }
	.key-list { background-color: #252329; border-color: #3a3840 #252329 #252329 #3a3840; }
	button.key-tag:hover { color: #c55815; }
}

body [hidden] { display: none; }
