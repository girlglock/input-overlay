body, div, p, fieldset, legend, h1, h2, h3, ul, ol, li, pre, blockquote, hr, article, section, menu {
	display: block;
}
body {
	width: 100%;
	height: 100%;
	margin: 0;
	overflow: hidden;
}
p { margin: 1em 0; }
h1 { font-size: 2em; margin: 0.67em 0; font-weight: bold; }
h2 { font-size: 1.5em; margin: 0.83em 0; font-weight: bold; }
h3 { font-size: 1.17em; margin: 1em 0; font-weight: bold; }
strong, b { font-weight: bold; }
ul, ol { margin: 1em 0; padding-left: 40dp; }
blockquote { margin: 1em 40dp; }
pre { white-space: pre; margin: 1em 0; }
hr { border-top-width: 1dp; border-top-color: #808080; margin: 0.5em 0; }
a { text-decoration: underline; cursor: pointer; }
button {
	display: inline-block;
	text-align: center;
	color: #000;
}
legend { padding: 0 2dp; }
progress { display: inline-block; }
input, select, label { display: inline-block; }
[hidden] { display: none; }
