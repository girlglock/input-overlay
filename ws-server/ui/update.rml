<rml>
<head>
	<title>Update Available</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="xp.rcss"/>
	<link type="text/rcss" href="styles.rcss"/>
</head>
<body>
	<div class="window">
		<div class="title-bar" data-drag-region="">
			<div class="title-bar-text" data-drag-region="">
				<img src="assets/icon.png" style="width:16dp;height:16dp;vertical-align:middle;margin-right:4dp;"/>Update Available
			</div>
			<div class="title-bar-controls">
				<button aria-label="Close" id="close-btn"></button>
			</div>
		</div>
		<div class="window-body update-popup-content">
			<div class="update-header">
				<img src="assets/update.gif" class="update-gif"/>
				<p id="update-version-text" class="update-popup-version"></p>
			</div>
			<fieldset class="update-notes-group">
				<legend>What's New</legend>
				<div id="update-notes" class="update-notes"></div>
			</fieldset>
			<div class="field-row update-popup-footer">
				<button id="update-now-btn">Update Now</button>
				<button id="update-skip-btn">Skip Version</button>
				<button id="update-later-btn">Later</button>
				<a class="accent-link" id="update-notes-link">View Release</a>
			</div>
		</div>
	</div>

	<div id="update-progress-modal" class="modal-overlay" hidden="">
		<div class="window">
			<div class="title-bar">
				<div class="title-bar-text">Updating...</div>
			</div>
			<div class="window-body">
				<p id="update-progress-status">starting...</p>
				<progress id="update-progress-fill" max="100" value="0" style="width: 100%;"/>
			</div>
		</div>
	</div>
</body>
</rml>
