-    widthClassToSlider(cls) {
-        if (!cls) return 100;
-        const m = /^u(\d+)(?:-(\d+))?$/.exec(cls);
-        if (!m) return 100;
-        const intPart = parseInt(m[1]);
-        if (!m[2]) return intPart * 100;
-        const decVal = m[2].length === 1 ? parseInt(m[2]) * 10 : parseInt(m[2]);
-        return intPart * 100 + decVal;
-    }
