-                        delete _this.buffer[scancode];
-                    }
-                    else
-                    {
-                        _this.buffer[scancode] = event.data.getUint8(7) / 200;
-                    }
-
-                    handler(_this._bufferToActiveKeys());
-                }
-            }
-        };
-    }
