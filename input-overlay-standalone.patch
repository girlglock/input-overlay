-pub async fn check(
-    current_version: &str,
-    dismissed: &[String],
-    asset_name: &str,
-) -> Option<UpdateInfo> {
-    let client = reqwest::Client::builder()
-        .user_agent("input-overlay-ws")
-        .timeout(std::time::Duration::from_secs(10))
-        .build()
-        .ok()?;
-
-    let release: GithubRelease = client
-        .get(GITHUB_API_URL)
