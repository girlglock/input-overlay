-            });
-
-            this._updatePanelToggleArrow(p);
-        });
-
-        new ResizeObserver(([entry]) => {
-            const narrow = entry.contentRect.width < THRESHOLD;
-            panels.forEach(p => {
-                if (narrow && !p.manualOpen) {
-                    p.el.classList.add("collapsed");
-                } else if (!narrow) {
-                    p.el.classList.remove("collapsed");
-                    p.manualOpen = false;
-                }
-                this._updatePanelToggleArrow(p);
