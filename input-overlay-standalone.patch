-
-    if parse_ver(&version) <= parse_ver(current_version) {
-        return None;
-    }
-    if dismissed.iter().any(|d| d == &version) {
-        return None;
-    }
-
-    let Some(asset) = release.assets.iter().find(|a| a.name == asset_name) else {
