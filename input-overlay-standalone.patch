-        AsProviderRazerHuntsman,
-        AsProviderRazerHuntsmanV3,
-        AsProviderNuphy,
-        AsProviderDrunkdeer,
-        AsProviderKeychron,
-        AsProviderMadlions,
-        AsProviderBytech,
