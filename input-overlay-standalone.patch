-pub fn parse_ver(v: &str) -> (u32, u32, u32) {
-    let s = v.trim_start_matches('v');
-    let mut p = s.splitn(3, '.');
-    let n = |x: Option<&str>| x.and_then(|s| s.parse().ok()).unwrap_or(0u32);
-    (n(p.next()), n(p.next()), n(p.next()))
