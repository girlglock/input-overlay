-            if (dir === "left") {
-                strip.style.left = (r.right - cfgRect.left) + "px";
-                strip.style.right = "";
-            } else {
-                strip.style.right = (cfgRect.right - r.left) + "px";
-                strip.style.left = "";
-            }
-        });
-    }
